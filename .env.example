# Host machine ports (Users can change these if they conflict with local apps)
HOST_APP_PORT=8080
HOST_DB_PORT=3306

# Database credentials
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword
DB_ROOT_PASSWORD=myrootpassword

# App connection URL (Internal container port stays 3306)
DB_URL=jdbc:mysql://db-container:3306/mydatabase
